# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# ===== CORS (origens permitidas para o frontend) =====
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ===== IA — Provedor padrão (openai | anthropic | gemini) =====
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2

# ===== Chaves por provedor (use a do provedor escolhido) =====
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-coloque_sua_chave_aqui
# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-coloque_sua_chave_aqui
# Google Gemini — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza-coloque_sua_chave_aqui
# Alias para GOOGLE_API_KEY
GEMINI_API_KEY=AIza-coloque_sua_chave_aqui

# Chave genérica (deprecated, mantida por compatibilidade)
# Se preenchida e a chave específica do AI_PROVIDER estiver vazia, será usada como fallback
AI_API_KEY=

# ===== Scraper =====
SCRAPER_TIMEOUT=30
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
SCRAPER_MAX_PAGES=10
